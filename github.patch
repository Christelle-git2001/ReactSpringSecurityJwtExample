diff --git a/.github/workflows/test-backend.yml b/.github/workflows/test-backend.yml
new file mode 100644
index 0000000..65a6758
--- /dev/null
+++ b/.github/workflows/test-backend.yml
@@ -0,0 +1,63 @@
+name: Backend Tests & Coverage
+
+on:
+  push:
+    branches: [ main, develop ]
+    paths:
+      - 'src/**'
+      - 'pom.xml'
+      - '.github/workflows/test-backend.yml'
+  pull_request:
+    branches: [ main, develop ]
+    paths:
+      - 'src/**'
+      - 'pom.xml'
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        java-version: ['25']
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+
+    - name: Set up Java ${{ matrix.java-version }}
+      uses: actions/setup-java@v5
+      with:
+        java-version: ${{ matrix.java-version }}
+        distribution: 'temurin'
+        cache: maven
+
+    - name: Run tests with Maven
+      run: mvn clean test
+
+    - name: Generate coverage report
+      run: mvn jacoco:report
+
+    - name: Upload coverage to Codecov
+      uses: codecov/codecov-action@v3
+      with:
+        files: ./target/site/jacoco/jacoco.xml
+        flags: backend
+        name: backend-coverage
+        fail_ci_if_error: false
+
+    - name: Archive test results
+      if: always()
+      uses: actions/upload-artifact@v4
+      with:
+        name: backend-test-results-java-${{ matrix.java-version }}
+        path: target/surefire-reports/
+        retention-days: 30
+
+    - name: Archive coverage report
+      if: always()
+      uses: actions/upload-artifact@v4
+      with:
+        name: backend-coverage-java-${{ matrix.java-version }}
+        path: target/site/jacoco/
+        retention-days: 30
diff --git a/.github/workflows/test-frontend.yml b/.github/workflows/test-frontend.yml
new file mode 100644
index 0000000..9747926
--- /dev/null
+++ b/.github/workflows/test-frontend.yml
@@ -0,0 +1,55 @@
+name: Frontend Tests & Coverage
+
+on:
+  push:
+    branches: [ main, develop ]
+    paths:
+      - 'react-vite-project/**'
+      - '.github/workflows/test-frontend.yml'
+  pull_request:
+    branches: [ main, develop ]
+    paths:
+      - 'react-vite-project/**'
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        node-version: [18.x, 20.x]
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+
+    - name: Setup Node.js ${{ matrix.node-version }}
+      uses: actions/setup-node@v4
+      with:
+        node-version: ${{ matrix.node-version }}
+        cache: 'npm'
+        cache-dependency-path: 'react-vite-project/package-lock.json'
+
+    - name: Install dependencies
+      working-directory: ./react-vite-project
+      run: npm ci
+
+    - name: Run tests with coverage
+      working-directory: ./react-vite-project
+      run: npm run test:coverage
+
+    - name: Upload coverage to Codecov
+      uses: codecov/codecov-action@v3
+      with:
+        files: ./react-vite-project/coverage/coverage-final.json
+        flags: frontend
+        name: frontend-coverage
+        fail_ci_if_error: false
+
+    - name: Archive coverage reports
+      if: always()
+      uses: actions/upload-artifact@v4
+      with:
+        name: frontend-coverage-node-${{ matrix.node-version }}
+        path: react-vite-project/coverage/
+        retention-days: 30
